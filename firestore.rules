rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed data model and authorization boundaries
    // ===============================================================
    // users/{uid}: private identity, role, class, plan, and XP fields.
    // studentLoginIndex/{u_|c_ alias}: immutable UID/auth-email mapping;
    //   browser reads denied, validated create-only writes during signup.
    // classes/{id}, lessons/{id}: teacher-owned educational content.
    // lessonProgress/{student_lesson}, lessonCompletions/{student_lesson},
    //   portfolio/{student_lesson_section}: student-owned learning records.
    // programs/{id}, plans/{id}: owner-managed product catalog.
    // programAccess, programPurchases, subscriptions, subscriptionPayments,
    //   paddleWebhookEvents, studentLoginRateLimits: server-written records.
    // Timestamps used for creation/update are Firestore timestamp values;
    // identity and ownership fields are immutable outside explicit workflows.
    // ===============================================================
    // TechMinds authorization model:
    // - users/{uid} is the source of truth for role and account status.
    // - owners manage the catalog and account status.
    // - teachers can only manage records tied to their own teacherId.
    // - students can only write their own learning data.
    // - billing/access documents are written only by trusted Cloud Functions.

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function currentUserExists() {
      return signedIn() && exists(userPath(request.auth.uid));
    }

    function currentUser() {
      return get(userPath(request.auth.uid)).data;
    }

    function accountIsActive(data) {
      return data.get('accountStatus', 'active') == 'active';
    }

    function hasRole(role) {
      return currentUserExists()
        && currentUser().role == role
        && accountIsActive(currentUser());
    }

    function isOwner() {
      return hasRole('owner');
    }

    function isTeacher() {
      return hasRole('teacher');
    }

    function isStudent() {
      return hasRole('student');
    }

    function shortString(value, maximum) {
      return value is string && value.size() > 0 && value.size() <= maximum;
    }

    function optionalString(data, field, maximum) {
      return !(field in data)
        || data[field] == null
        || (data[field] is string && data[field].size() <= maximum);
    }

    function nonNegativeNumber(value, maximum) {
      return value is number && value >= 0 && value <= maximum;
    }

    function validRole(role) {
      return role in ['owner', 'teacher', 'student'];
    }

    function validAccountStatus(status) {
      return status in ['active', 'inactive', 'suspended'];
    }

    function userCreateKeysAreValid(data) {
      return data.keys().hasAll([
          'uid', 'name', 'role', 'plan', 'subscriptionStatus',
          'accountStatus', 'createdAt'
        ])
        && data.keys().hasOnly([
          'uid', 'name', 'email', 'phoneNumber', 'photoURL', 'role',
          'authProvider', 'preferredLanguage', 'studentAccountType', 'username', 'usernameNormalized', 'studentCode',
          'authEmail', 'teacherId', 'teacherName', 'classId', 'className',
          'classCode', 'grade', 'learningTrack', 'xp', 'level', 'badges',
          'completedLessons', 'plan', 'subscriptionStatus', 'billingCycle',
          'subscriptionId', 'paymentStatus', 'selectedTrack', 'pendingPlan',
          'pendingBillingCycle', 'pendingTrack', 'pendingPurchase',
          'pendingPurchaseUpdatedAt', 'accountStatus', 'createdBy',
          'createdByRole', 'createdAt', 'updatedAt'
        ]);
    }

    function validUserCreate(data, userId) {
      return userCreateKeysAreValid(data)
        && data.uid == userId
        && shortString(data.name, 120)
        && validRole(data.role)
        && validAccountStatus(data.accountStatus)
        && data.accountStatus == 'active'
        && data.createdAt == request.time
        && optionalString(data, 'email', 320)
        && optionalString(data, 'phoneNumber', 40)
        && (!('preferredLanguage' in data) || data.preferredLanguage in ['en', 'ar', 'he'])
        && optionalString(data, 'photoURL', 2048)
        && optionalString(data, 'username', 60)
        && optionalString(data, 'usernameNormalized', 60)
        && optionalString(data, 'studentCode', 60)
        && optionalString(data, 'authEmail', 320)
        && optionalString(data, 'teacherId', 128)
        && optionalString(data, 'classId', 128)
        && optionalString(data, 'classCode', 60)
        && (!('studentAccountType' in data)
          || data.studentAccountType in ['class', 'independent'])
        && data.get('badges', []) is list
        && data.get('badges', []).size() <= 100
        && nonNegativeNumber(data.get('xp', 0), 100000000)
        && nonNegativeNumber(data.get('level', 1), 100000);
    }

    function validSelfRegistration(data, userId) {
      return isSelf(userId)
        && data.role in ['teacher', 'student']
        && data.plan == 'free'
        && data.subscriptionStatus in ['inactive', 'free']
        && data.get('xp', 0) == 0
        && data.get('level', 1) == 1
        && (data.role != 'student'
          || (data.studentAccountType == 'independent'
            && ((request.auth.token.get('email', null) != null
                && data.email == request.auth.token.email
                && data.authEmail == request.auth.token.email)
              || (request.auth.token.get('phone_number', null) != null
                && data.get('phoneNumber', null) == request.auth.token.phone_number
                && data.get('authProvider', '') == 'phone'
                && data.get('email', null) == request.auth.token.get('email', null)
                && data.get('authEmail', null) == request.auth.token.get('email', null)))
            && data.get('teacherId', null) == null
            && data.get('classId', null) == null));
    }

    function validTeacherCreatedStudent(data, userId) {
      return isTeacher()
        && data.role == 'student'
        && data.studentAccountType == 'class'
        && data.uid == userId
        && data.teacherId == request.auth.uid
        && shortString(data.classId, 128)
        && exists(/databases/$(database)/documents/classes/$(data.classId))
        && get(/databases/$(database)/documents/classes/$(data.classId)).data.teacherId
          == request.auth.uid
        && data.plan == 'classAccess'
        && data.subscriptionStatus == 'teacher_managed'
        && data.get('createdBy', '') == 'teacher'
        && data.get('xp', 0) == 0
        && data.get('level', 1) == 1;
    }

    function identityIsUnchanged() {
      return request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.get('usernameNormalized', null)
          == resource.data.get('usernameNormalized', null)
        && request.resource.data.get('studentCode', null)
          == resource.data.get('studentCode', null)
        && request.resource.data.get('studentAccountType', null)
          == resource.data.get('studentAccountType', null);
    }

    function isSelfProfileUpdate(userId) {
      return isSelf(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'preferredLanguage', 'phoneNumber', 'photoURL',
          'age', 'grade', 'city', 'updatedAt'
        ])
        && shortString(request.resource.data.name, 120)
        && optionalString(request.resource.data, 'phoneNumber', 40)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['preferredLanguage'])
          || request.resource.data.preferredLanguage in ['en', 'ar', 'he'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['age'])
          || request.resource.data.age == null
          || (request.resource.data.age is number
            && request.resource.data.age >= 5
            && request.resource.data.age <= 120))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['grade'])
          || request.resource.data.grade == null
          || (request.resource.data.grade is string
            && request.resource.data.grade.size() <= 40))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['city'])
          || request.resource.data.city == null
          || (request.resource.data.city is string
            && request.resource.data.city.size() <= 120))
        && optionalString(request.resource.data, 'photoURL', 2048)
        && request.resource.data.updatedAt == request.time;
    }

    function isSelfPlanSelection(userId) {
      return isSelf(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'plan', 'subscriptionStatus', 'paymentStatus', 'billingCycle',
          'selectedTrack', 'pendingPlan', 'pendingBillingCycle',
          'pendingTrack', 'planUpdatedAt', 'planSelectionUpdatedAt'
        ])
        && request.resource.data.get('plan', 'free') in [resource.data.get('plan', 'free'), 'free']
        && request.resource.data.get('subscriptionStatus', 'inactive')
          in [resource.data.get('subscriptionStatus', 'inactive'), 'free', 'inactive']
        && request.resource.data.get('paymentStatus', 'not_started')
          in ['not_started', 'not_required', 'school_request']
        && optionalString(request.resource.data, 'pendingPlan', 128)
        && optionalString(request.resource.data, 'pendingBillingCycle', 32)
        && optionalString(request.resource.data, 'pendingTrack', 128)
        && optionalString(request.resource.data, 'selectedTrack', 128)
        && (request.resource.data.get('planUpdatedAt', null) == request.time
          || request.resource.data.get('planSelectionUpdatedAt', null) == request.time);
    }

    function isSelfPendingPurchase(userId) {
      return isSelf(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'pendingPurchase', 'pendingPurchaseUpdatedAt'
        ])
        && request.resource.data.pendingPurchase is map
        && request.resource.data.pendingPurchase.keys().hasAll([
          'type', 'programId', 'licenseType', 'createdAt'
        ])
        && request.resource.data.pendingPurchase.keys().hasOnly([
          'type', 'programId', 'licenseType', 'classId', 'createdAt'
        ])
        && request.resource.data.pendingPurchase.type == 'program'
        && shortString(request.resource.data.pendingPurchase.programId, 128)
        && request.resource.data.pendingPurchase.licenseType
          in ['student', 'teacher', 'class']
        && optionalString(request.resource.data.pendingPurchase, 'classId', 128)
        && shortString(request.resource.data.pendingPurchase.createdAt, 64)
        && request.resource.data.pendingPurchaseUpdatedAt == request.time;
    }

    function isTeacherManagingStudent() {
      return isTeacher()
        && resource.data.role == 'student'
        && resource.data.teacherId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'accountStatus', 'className', 'classCode', 'grade',
          'learningTrack', 'updatedAt'
        ])
        && validAccountStatus(request.resource.data.accountStatus)
        && request.resource.data.updatedAt == request.time;
    }

    function isOwnerChangingAccountStatus() {
      return isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'accountStatus', 'accountStatusUpdatedAt', 'accountStatusUpdatedBy'
        ])
        && validAccountStatus(request.resource.data.accountStatus)
        && request.resource.data.accountStatusUpdatedAt == request.time
        && request.resource.data.accountStatusUpdatedBy == request.auth.uid;
    }

    function isOwnerChangingProgramGrants() {
      return isOwner()
        && resource.data.role in ['student', 'teacher']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerGrantedProgramIds'])
        && request.resource.data.ownerGrantedProgramIds is list
        && request.resource.data.ownerGrantedProgramIds.size() <= 1000;
    }

    function teacherOwnsStudentClass(data) {
      return isTeacher()
        && shortString(data.get('classId', ''), 128)
        && exists(/databases/$(database)/documents/classes/$(data.classId))
        && get(/databases/$(database)/documents/classes/$(data.classId)).data.teacherId
          == request.auth.uid;
    }

    function memberId(classId, studentId) {
      return classId + '_' + studentId;
    }

    function isActiveClassMember(classId, studentId) {
      return classId is string && classId.size() > 0 && classId.size() <= 128
        && studentId is string && studentId.size() > 0 && studentId.size() <= 128
        && exists(/databases/$(database)/documents/classMembers/$(memberId(classId, studentId)))
        && get(/databases/$(database)/documents/classMembers/$(memberId(classId, studentId))).data.status == 'active'
        && get(/databases/$(database)/documents/classMembers/$(memberId(classId, studentId))).data.studentId == studentId
        && get(/databases/$(database)/documents/classMembers/$(memberId(classId, studentId))).data.classId == classId;
    }

    match /users/{userId} {
      allow get: if isSelf(userId)
        || isOwner()
        || (isTeacher() && resource.data.teacherId == request.auth.uid)
        || teacherOwnsStudentClass(resource.data);
      allow list: if isOwner()
        || (isTeacher() && resource.data.teacherId == request.auth.uid)
        || teacherOwnsStudentClass(resource.data);
      allow create: if validUserCreate(request.resource.data, userId)
        && (validSelfRegistration(request.resource.data, userId)
          || validTeacherCreatedStudent(request.resource.data, userId));
      allow update: if identityIsUnchanged()
        && (isSelfProfileUpdate(userId)
          || isSelfPlanSelection(userId)
          || isSelfPendingPurchase(userId)
          || isTeacherManagingStudent()
          || isOwnerChangingAccountStatus()
          || isOwnerChangingProgramGrants());
      allow delete: if false;
    }

    // Only trusted Cloud Functions may resolve an alias. Browser clients can
    // create the two immutable records as part of an authorized signup batch,
    // but can never read, query, update, or delete them.
    match /studentLoginIndex/{indexId} {
      allow read: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['uid', 'authEmail', 'type', 'createdAt'])
        && request.resource.data.keys().hasOnly([
          'uid', 'authEmail', 'teacherId', 'classId', 'type', 'createdAt'
        ])
        && request.resource.data.type in ['username', 'code']
        && shortString(request.resource.data.uid, 128)
        && shortString(request.resource.data.authEmail, 320)
        && request.resource.data.createdAt == request.time
        && !exists(userPath(request.resource.data.uid))
        && existsAfter(userPath(request.resource.data.uid))
        && getAfter(userPath(request.resource.data.uid)).data.role == 'student'
        && request.resource.data.authEmail
          == getAfter(userPath(request.resource.data.uid)).data.authEmail
        && request.resource.data.get('teacherId', null)
          == getAfter(userPath(request.resource.data.uid)).data.get('teacherId', null)
        && request.resource.data.get('classId', null)
          == getAfter(userPath(request.resource.data.uid)).data.get('classId', null)
        && ((request.resource.data.type == 'username'
            && indexId == 'u_' + getAfter(
              userPath(request.resource.data.uid)
            ).data.usernameNormalized)
          || (request.resource.data.type == 'code'
            && indexId == 'c_' + getAfter(
              userPath(request.resource.data.uid)
            ).data.studentCode.lower()))
        && (request.auth.uid == request.resource.data.uid
          || (isTeacher()
            && getAfter(userPath(request.resource.data.uid)).data.teacherId
              == request.auth.uid));
      allow update, delete: if false;
    }

    function validClass(data, classId) {
      return data.keys().hasAll([
          'id', 'teacherId', 'name', 'classCode', 'studentCount',
          'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'teacherId', 'teacherName', 'teacherEmail', 'name', 'grade',
          'learningTrack', 'classCode', 'studentCount', 'status',
          'createdAt', 'updatedAt'
        ])
        && data.id == classId
        && shortString(data.teacherId, 128)
        && shortString(data.name, 120)
        && shortString(data.classCode, 60)
        && nonNegativeNumber(data.studentCount, 100000)
        && data.status in ['active', 'inactive', 'archived'];
    }

    match /classes/{classId} {
      allow get: if isOwner()
        || (isTeacher() && resource.data.teacherId == request.auth.uid)
        || (isStudent() && resource.data.status == 'active');
      allow list: if isOwner()
        || (isTeacher() && resource.data.teacherId == request.auth.uid);
      allow create: if isTeacher()
        && validClass(request.resource.data, classId)
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.studentCount == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if (isOwner()
          || (isTeacher() && resource.data.teacherId == request.auth.uid))
        && validClass(request.resource.data, classId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.classCode == resource.data.classCode
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /classCodes/{codeId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if isTeacher()
        && request.resource.data.keys().hasAll([
          'classId', 'classCode', 'teacherId', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'classId', 'classCode', 'teacherId', 'createdAt'
        ])
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && existsAfter(
          /databases/$(database)/documents/classes/$(request.resource.data.classId)
        )
        && getAfter(
          /databases/$(database)/documents/classes/$(request.resource.data.classId)
        ).data.teacherId == request.auth.uid;
      allow update, delete: if false;
    }

    function validProgram(data) {
      return data.keys().hasAll([
          'title', 'description', 'status', 'createdBy', 'createdAt', 'updatedAt',
          'accessType', 'price'
        ])
        && data.keys().hasOnly([
          'title', 'description', 'icon', 'category', 'ageFrom', 'ageTo',
          'level', 'grades', 'pricing', 'purchaseOptions', 'finalProject', 'status',
          'sellable', 'programType', 'createdBy', 'createdByRole', 'ownerName',
          'lessonCount', 'salesCount', 'studentsCount', 'currency', 'paddlePriceIds',
          'createdAt', 'updatedAt', 'publishedAt',
          'accessType', 'price', 'paymentProvider', 'paymentProductId',
          'previewLessonCount', 'learningOutcomes'
        ])
        && data.title is map
        && data.description is map
        && data.title.size() <= 10
        && data.description.size() <= 10
        && data.status in ['draft', 'published', 'archived']
        && data.accessType in ['free', 'paid', 'class']
        && data.get('previewLessonCount', 1) is int
        && data.get('previewLessonCount', 1) >= 0
        && data.get('previewLessonCount', 1) <= 10000
        && (!('learningOutcomes' in data) || (data.learningOutcomes is map
          && data.learningOutcomes.keys().hasOnly(['en', 'ar', 'he'])
          && data.learningOutcomes.get('en', []) is list && data.learningOutcomes.get('en', []).size() <= 20
          && data.learningOutcomes.get('ar', []) is list && data.learningOutcomes.get('ar', []).size() <= 20
          && data.learningOutcomes.get('he', []) is list && data.learningOutcomes.get('he', []).size() <= 20))
        && nonNegativeNumber(data.price, 1000000)
        && (data.accessType != 'free' || data.price == 0)
        && data.get('currency', 'ILS') == 'ILS'
        && (data.get('paymentProvider', null) == null || shortString(data.paymentProvider, 128))
        && (data.get('paymentProductId', null) == null || shortString(data.paymentProductId, 256));
    }

    // Legacy catalog records can change publication state without a schema migration.
    // Content, ownership, and payment fields cannot change through this exception.
    function legacyProgramStatusUpdate() {
      return !resource.data.keys().hasAll(['accessType', 'price'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'publishedAt', 'updatedAt'])
        && request.resource.data.status in ['draft', 'published']
        && ((request.resource.data.status == 'published' && request.resource.data.publishedAt == request.time)
          || (request.resource.data.status == 'draft' && request.resource.data.publishedAt == null));
    }

    match /programs/{programId} {
      allow read: if (resource.data.status == 'published') || isOwner();
      allow create: if isOwner()
        && validProgram(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner()
        && (validProgram(request.resource.data) || legacyProgramStatusUpdate())
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner();
    }

    match /plans/{planId} {
      // Plans are a public product catalog and contain no customer records.
      allow read: if true;
      allow create: if isOwner()
        && request.resource.data.keys().hasAll([
          'audience', 'name', 'active', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    function studentCanReadLesson(data, lessonId) {
      return isStudent()
        && data.status == 'published'
        && (
          // Normal lesson published to one of the student's active classes.
          isActiveClassMember(data.get('classId', ''), request.auth.uid)

          // Commercial lesson from a program available to this student.
          || (
            data.get('lessonType', '') == 'commercial'
            && shortString(data.get('programId', ''), 128)
            && (
              hasOwnerGrantedProgramAccess(data.programId)
              || hasFreeProgramAccess(data.programId)
              || hasManualProgramAccess(data.programId, lessonId)
              || hasParentMissionAccess(data, lessonId)
              || hasPersonalMissionAccess(data.programId)
              || hasClassProgramAccess(
                data.programId,
                currentUser().get('classId', '')
              )
            )
          )
        );
    }

    function validLesson(data) {
      return data.keys().hasAll(['status', 'sections', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'programId', 'lessonType', 'sellable', 'createdBy', 'createdByRole',
          'teacherId', 'teacherName', 'classId', 'className', 'classCode',
          'grade', 'learningTrack', 'sourceType', 'templateId', 'title',
          'titleI18n', 'description', 'descriptionI18n', 'minutes',
          'estimatedMinutes', 'xp', 'xpReward', 'activityType', 'resourceUrl',
          'coverImage', 'imageAlt', 'themeColor', 'accentColor', 'surfaceColor',
          'status', 'lessonNumber', 'order', 'sections', 'slideCount',
          'completedCount', 'createdAt', 'updatedAt', 'publishedAt', 'archivedAt', 'parentLessonId'
        ])
        && data.status in ['draft', 'published', 'archived']
        && data.sections is list
        && data.sections.size() <= 300
        && optionalString(data, 'resourceUrl', 2048)
        && optionalString(data, 'coverImage', 2048)
        && (!('imageAlt' in data)
          || (data.imageAlt is map && data.imageAlt.size() <= 10))
        && (!('themeColor' in data)
          || (data.themeColor is string
            && data.themeColor.matches('^#[0-9a-fA-F]{6}$')))
        && (!('accentColor' in data)
          || (data.accentColor is string
            && data.accentColor.matches('^#[0-9a-fA-F]{6}$')))
        && (!('surfaceColor' in data)
          || (data.surfaceColor is string
            && data.surfaceColor.matches('^#[0-9a-fA-F]{6}$')))
        && nonNegativeNumber(data.get('xpReward', data.get('xp', 0)), 10000);
    }

    match /lessons/{lessonId} {
      allow read: if isOwner()
        || (isTeacher() && resource.data.teacherId == request.auth.uid)
        || studentCanReadLesson(resource.data, lessonId);
      allow create: if validLesson(request.resource.data)
        && !('parentLessonId' in request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && ((isOwner()
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.lessonType == 'commercial')
          || (isTeacher()
            && request.resource.data.teacherId == request.auth.uid
            && exists(/databases/$(database)/documents/classes/$(request.resource.data.classId))
            && get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.teacherId
              == request.auth.uid));
      allow update: if validLesson(request.resource.data)
        && request.resource.data.get('parentLessonId', null) == resource.data.get('parentLessonId', null)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null)
        && request.resource.data.get('teacherId', null) == resource.data.get('teacherId', null)
        && request.resource.data.get('classId', null) == resource.data.get('classId', null)
        && request.resource.data.updatedAt == request.time
        && (isOwner()
          || (isTeacher() && resource.data.teacherId == request.auth.uid));
      allow delete: if isOwner() && resource.data.get('lessonType', '') == 'commercial';
    }

    match /attendance/{attendanceId} {
      // The attendance page reads the daily document before its first save.
      // For an absent record, authorize against the existing class, not resource.data.
      allow get: if isTeacher()
        && !exists(/databases/$(database)/documents/attendance/$(attendanceId))
        && attendanceId.matches('^.+_[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && get(/databases/$(database)/documents/classes/$(attendanceId.replace('_[0-9]{4}-[0-9]{2}-[0-9]{2}$', ''))).data.teacherId == request.auth.uid;
      allow read: if isOwner()
        || (isTeacher() && resource.data.teacherId == request.auth.uid);
      allow create, update: if isTeacher()
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.attendanceId == attendanceId
        && attendanceId == request.resource.data.classId + '_' + request.resource.data.date
        && shortString(request.resource.data.classId, 128)
        && shortString(request.resource.data.date, 32)
        && exists(/databases/$(database)/documents/classes/$(request.resource.data.classId))
        && get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.teacherId
          == request.auth.uid
        && request.resource.data.students is map
        && request.resource.data.students.size() <= 1000
        && request.resource.data.studentCount is int
        && request.resource.data.studentCount >= 0
        && request.resource.data.studentCount <= 1000
        && request.resource.data.updatedAt == request.time
        && ((resource == null && request.resource.data.createdAt == request.time)
          || (resource != null
            && request.resource.data.createdAt == resource.data.createdAt));
      allow delete: if false;
    }

    // Mission state is optional: existing lesson schemas and behavior are preserved.
    function validMissionProgress(data, lesson) {
      return !('mission' in data) || (lesson.get('activityType', '') == 'mission'
        && data.mission is map
        && data.mission.keys().hasAll(['version', 'currentScreen', 'screens', 'skills'])
        && data.mission.keys().hasOnly(['version', 'currentScreen', 'screens', 'skills'])
        && data.mission.version == 1
        && data.mission.currentScreen is int
        && data.mission.currentScreen >= 0
        && data.mission.currentScreen < lesson.sections.size()
        && data.currentSlide == data.mission.currentScreen
        && data.mission.screens is map
        && data.mission.screens.size() <= 300
        && data.mission.skills is map
        && data.mission.skills.size() <= 50);
    }

    // Personal program access is server-written. Keep classroom access unchanged.
    function studentCanPersistMission(lesson, accessClassId, lessonId) {
      return studentCanReadLesson(lesson, lessonId)
        || (isStudent()
          && lesson.get('activityType', '') == 'mission'
          && lesson.get('lessonType', '') == 'commercial'
          && lesson.status == 'published'
          && shortString(lesson.get('programId', ''), 128)
          && (hasOwnerGrantedProgramAccess(lesson.programId)
            || hasManualProgramAccess(lesson.programId, lessonId)
            || hasParentMissionAccess(lesson, lessonId)
            || hasFreeProgramAccess(lesson.programId) || hasPersonalMissionAccess(lesson.programId)
            || hasClassProgramAccess(lesson.programId, accessClassId)));
    }

    function hasClassProgramAccess(programId, classId) {
      let assignmentId = classId + '_program_' + programId;
      let accessId = 'class_' + classId + '_' + programId;
      let program = get(/databases/$(database)/documents/programs/$(programId)).data;
      return classId is string && classId.size() > 0 && classId.size() <= 128
          && program.status == 'published'
          && program.get('accessType', '') in ['free', 'paid', 'class']
          && isActiveClassMember(classId, request.auth.uid)
          && ((exists(/databases/$(database)/documents/programAccess/$(accessId))
                && get(/databases/$(database)/documents/programAccess/$(accessId)).data.status == 'active'
                && get(/databases/$(database)/documents/programAccess/$(accessId)).data.programId == programId
                && get(/databases/$(database)/documents/programAccess/$(accessId)).data.classId == classId)
              || (exists(/databases/$(database)/documents/classAssignments/$(assignmentId))
                && get(/databases/$(database)/documents/classAssignments/$(assignmentId)).data.status == 'active'));
    }

    function hasFreeProgramAccess(programId) {
      let program = get(/databases/$(database)/documents/programs/$(programId)).data;
      return program.status == 'published' && program.get('accessType', '') == 'free';
    }

    function hasManualProgramAccess(programId, lessonId) {
      let accessId = request.auth.uid + '_' + programId;
      let path = /databases/$(database)/documents/programAccess/$(accessId);
      return exists(path) && get(path).data.userId == request.auth.uid
        && get(path).data.programId == programId && get(path).data.active == true
        && (get(path).data.get('accessScope', 'full') == 'full'
          || (get(path).data.get('accessScope', '') == 'selected'
            && get(path).data.get('lessonIds', []) is list
            && lessonId in get(path).data.get('lessonIds', [])))
        && (get(path).data.expiresAt == null
          || (get(path).data.expiresAt is timestamp && get(path).data.expiresAt > request.time))
        && get(/databases/$(database)/documents/programs/$(programId)).data.status == 'published';
    }

    function hasParentMissionAccess(mission, missionId) {
      let parentId = mission.get('parentLessonId', '');
      return parentId is string && parentId.size() > 0 && parentId.size() <= 128
        && parentId != missionId
        && mission.get('contentType', mission.get('activityType', '')) == 'mission'
        && exists(/databases/$(database)/documents/lessons/$(parentId))
        && validMissionParentRecord(mission, get(/databases/$(database)/documents/lessons/$(parentId)).data)
        && hasManualProgramAccess(mission.programId, parentId);
    }

    function validMissionParentRecord(mission, parent) {
      return parent.status == 'published' && parent.get('lessonType', '') == 'commercial'
        && parent.get('programId', '') == mission.programId
        && parent.get('parentLessonId', null) == null
        && parent.get('contentType', 'lesson') == 'lesson'
        && (parent.get('contentType', '') == 'lesson' || !(parent.get('activityType', '') in ['mission', 'quiz', 'activity']));
    }

    function hasOwnerGrantedProgramAccess(programId) {
      return currentUser().get('ownerGrantedProgramIds', []) is list
        && programId in currentUser().get('ownerGrantedProgramIds', [])
        && get(/databases/$(database)/documents/programs/$(programId)).data.status == 'published';
    }

    function hasPersonalMissionAccess(programId) {
      let accessId = 'student_' + request.auth.uid + '_' + programId;
      let access = get(/databases/$(database)/documents/programAccess/$(accessId)).data;
      return get(/databases/$(database)/documents/programs/$(programId)).data.status == 'published'
        && get(/databases/$(database)/documents/programs/$(programId)).data.get('accessType', '') == 'paid'
        && access.status == 'active'
        && access.programId == programId
        && (access.get('userId', '') == request.auth.uid
          || access.get('studentId', '') == request.auth.uid);
    }

    function validStudentProgress(data, progressId) {
      let lesson = get(/databases/$(database)/documents/lessons/$(data.lessonId)).data;
      return data.keys().hasAll([
          'studentId', 'lessonId', 'teacherId', 'classId', 'currentSlide',
          'maxUnlockedSlide', 'selectedAnswers', 'answerResults',
          'taskAnswers', 'status', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'studentId', 'studentName', 'lessonId', 'lessonTitle', 'teacherId',
          'classId', 'className', 'currentSlide', 'maxUnlockedSlide',
          'selectedAnswers', 'answerResults', 'taskAnswers', 'status',
          'teacherFeedback', 'teacherReviewedAt', 'createdAt', 'completedAt',
          'updatedAt', 'mission', 'programAccessClassId'
        ])
        && data.studentId == request.auth.uid
        && progressId == request.auth.uid + '_' + data.lessonId
        && exists(/databases/$(database)/documents/lessons/$(data.lessonId))
        && studentCanPersistMission(lesson, data.get('programAccessClassId', ''), data.lessonId)
        && data.teacherId == lesson.get('teacherId', null)
        && data.classId == lesson.get('classId', null)
        && nonNegativeNumber(data.currentSlide, 10000)
        && nonNegativeNumber(data.maxUnlockedSlide, 10000)
        && data.selectedAnswers is map
        && data.selectedAnswers.size() <= 500
        && data.answerResults is map
        && data.answerResults.size() <= 500
        && data.taskAnswers is map
        && data.taskAnswers.size() <= 500
        && validMissionProgress(data, lesson)
        && data.status == 'in_progress'
        && data.updatedAt == request.time;
    }

    match /lessonProgress/{progressId} {
      // A first visit must be able to establish that its own record is absent.
      allow get: if isStudent()
        && progressId.matches(request.auth.uid + '_.*')
        && !exists(/databases/$(database)/documents/lessonProgress/$(progressId));
      allow read: if isOwner()
        || (isStudent() && resource.data.studentId == request.auth.uid)
        || (isTeacher() && resource.data.teacherId == request.auth.uid);
      allow create: if isStudent()
        && validStudentProgress(request.resource.data, progressId)
        && (!(request.resource.data.keys().hasAny(['createdAt']))
          || request.resource.data.createdAt == request.time);
      allow update: if (isStudent()
          && validStudentProgress(request.resource.data, progressId)
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.lessonId == resource.data.lessonId
          && request.resource.data.teacherId == resource.data.teacherId
          && request.resource.data.classId == resource.data.classId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'studentName', 'lessonTitle', 'className', 'currentSlide',
            'maxUnlockedSlide', 'selectedAnswers', 'answerResults',
            'taskAnswers', 'status', 'completedAt', 'updatedAt', 'mission', 'programAccessClassId'
          ]))
        || (isTeacher()
          && resource.data.teacherId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'teacherFeedback', 'teacherReviewedAt'
          ])
          && request.resource.data.teacherFeedback is map
          && request.resource.data.teacherFeedback.size() <= 500
          && request.resource.data.teacherReviewedAt == request.time);
      allow delete: if false;
    }

    match /lessonCompletions/{completionId} {
      allow get: if isStudent()
        && completionId.matches(request.auth.uid + '_.*')
        && !exists(/databases/$(database)/documents/lessonCompletions/$(completionId));
      allow read: if isOwner()
        || (isStudent() && resource.data.studentId == request.auth.uid)
        || (isTeacher() && resource.data.teacherId == request.auth.uid);
      // Completion receipts and XP are written atomically by completeLesson.
      // Browser transactions cannot manufacture an XP-bearing receipt.
      allow create, update, delete: if false;
    }

    match /portfolio/{portfolioId} {
      allow read: if isOwner()
        || (isStudent() && resource.data.studentId == request.auth.uid)
        || (isTeacher() && resource.data.teacherId == request.auth.uid);
      allow create, update: if isStudent()
        && request.resource.data.studentId == request.auth.uid
        && portfolioId == request.auth.uid + '_' + request.resource.data.lessonId
          + '_' + request.resource.data.sectionId
        && request.resource.data.keys().hasAll([
          'studentId', 'lessonId', 'sectionId', 'teacherId', 'classId',
          'title', 'description', 'answer', 'status', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'studentId', 'studentName', 'teacherId', 'classId', 'className',
          'lessonId', 'lessonTitle', 'sectionId', 'title', 'description',
          'answer', 'projectType', 'status', 'createdAt', 'updatedAt'
        ])
        && shortString(request.resource.data.lessonId, 128)
        && shortString(request.resource.data.sectionId, 128)
        && request.resource.data.answer is string
        && request.resource.data.answer.size() <= 20000
        && request.resource.data.status == 'completed'
        && exists(/databases/$(database)/documents/lessons/$(request.resource.data.lessonId))
        && studentCanReadLesson(
          get(/databases/$(database)/documents/lessons/$(request.resource.data.lessonId)).data,
          request.resource.data.lessonId
        )
        && request.resource.data.teacherId
          == get(/databases/$(database)/documents/lessons/$(request.resource.data.lessonId)).data.teacherId
        && request.resource.data.classId
          == get(/databases/$(database)/documents/lessons/$(request.resource.data.lessonId)).data.classId
        && request.resource.data.updatedAt == request.time
        && (resource == null
          || (request.resource.data.studentId == resource.data.studentId
            && request.resource.data.lessonId == resource.data.lessonId
            && request.resource.data.sectionId == resource.data.sectionId
            && request.resource.data.teacherId == resource.data.teacherId
            && request.resource.data.classId == resource.data.classId));
      allow delete: if false;
    }

    match /platformSettings/public {
      allow read: if true;
      allow create, update: if isOwner()
        && request.resource.data.keys().hasAll([
          'platformName', 'supportEmail', 'supportPhone', 'whatsapp',
          'updatedBy', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'platformName', 'supportEmail', 'supportPhone', 'whatsapp',
          'updatedBy', 'updatedAt'
        ])
        && shortString(request.resource.data.platformName, 120)
        && request.resource.data.supportEmail is string
        && request.resource.data.supportEmail.size() <= 320
        && request.resource.data.supportPhone is string
        && request.resource.data.supportPhone.size() <= 40
        && request.resource.data.whatsapp is string
        && request.resource.data.whatsapp.size() <= 40
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /platformSettings/{document=**} {
      allow read, write: if false;
    }

    match /programAccess/{accessId} {
      allow get: if isOwner()
        || (signedIn() && resource.data.get('userId', '') == request.auth.uid)
        || (isTeacher() && resource.data.get('teacherId', '') == request.auth.uid)
        || (isStudent()
          && isActiveClassMember(resource.data.get('classId', ''), request.auth.uid));
      allow list: if isOwner()
        || (signedIn() && resource.data.get('userId', '') == request.auth.uid);
      allow write: if false;

      match /private/{document} {
        allow read: if isOwner();
        allow write: if false;
      }
    }

    // Learners can create only their own canonical pending request. Reviews and
    // grants are written atomically by owner-authorized callable Functions.
    function validAccessRequest(data, requestId) {
      return data.keys().hasAll(['userId', 'userEmail', 'programId', 'status', 'createdAt'])
        && data.keys().hasOnly(['userId', 'userEmail', 'programId', 'status', 'createdAt'])
        && shortString(data.programId, 128)
        && data.userId == request.auth.uid
        && requestId == request.auth.uid + '_' + data.programId
        && data.userEmail == currentUser().get('email', currentUser().get('authEmail', null))
        && (data.userEmail == null || (data.userEmail is string && data.userEmail.size() <= 320))
        && data.status == 'pending' && data.createdAt == request.time
        && get(/databases/$(database)/documents/programs/$(data.programId)).data.status == 'published'
        && !(get(/databases/$(database)/documents/programs/$(data.programId)).data.get('accessType', '') in ['free', 'class']);
    }

    match /accessRequests/{requestId} {
      allow get: if isOwner() || ((isStudent() || isTeacher())
        && requestId.matches(request.auth.uid + '_.*')
        && !exists(/databases/$(database)/documents/accessRequests/$(requestId)));
      allow read: if isOwner() || ((isStudent() || isTeacher()) && resource.data.userId == request.auth.uid);
      allow create: if (isStudent() || isTeacher()) && validAccessRequest(request.resource.data, requestId);
      allow update, delete: if false;
      match /private/{document} {
        allow read: if isOwner();
        allow write: if false;
      }
    }

    match /programPurchases/{purchaseId} {
      allow read: if isOwner()
        || (signedIn() && resource.data.get('userId', '') == request.auth.uid);
      allow write: if false;
    }

    // Callable Functions manage existing memberships. A teacher may atomically
    // create an active membership for a student they manage in a class they own.
    match /classMembers/{membershipId} {
      allow get: if isOwner()
        || (isStudent() && resource.data.studentId == request.auth.uid)
        || (isTeacher() && resource.data.teacherId == request.auth.uid);
      allow list: if isOwner()
        || (isTeacher() && resource.data.teacherId == request.auth.uid)
        || (isTeacher()
          && exists(/databases/$(database)/documents/classes/$(resource.data.classId))
          && get(/databases/$(database)/documents/classes/$(resource.data.classId)).data.teacherId == request.auth.uid)
        || (isStudent() && resource.data.studentId == request.auth.uid);
      allow create: if isTeacher()
        && request.resource.data.keys().hasAll([
          'classId', 'studentId', 'teacherId', 'status', 'joinedAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'classId', 'studentId', 'teacherId', 'status', 'joinedAt', 'updatedAt'
        ])
        && membershipId == memberId(
          request.resource.data.classId, request.resource.data.studentId
        )
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.joinedAt == request.time
        && request.resource.data.updatedAt == request.time
        && exists(/databases/$(database)/documents/classes/$(request.resource.data.classId))
        && get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.teacherId
          == request.auth.uid
        && existsAfter(userPath(request.resource.data.studentId))
        && getAfter(userPath(request.resource.data.studentId)).data.role == 'student'
        && getAfter(userPath(request.resource.data.studentId)).data.teacherId == request.auth.uid;
      allow update, delete: if false;
    }

    match /classAssignments/{assignmentId} {
      allow get: if isOwner()
        || (isTeacher() && resource.data.teacherId == request.auth.uid)
        || (isStudent() && isActiveClassMember(resource.data.classId, request.auth.uid));
      allow list: if isOwner()
        || (isTeacher() && resource.data.teacherId == request.auth.uid)
        || (isStudent() && isActiveClassMember(resource.data.classId, request.auth.uid));
      allow write: if false;
    }

    match /subscriptions/{userId} {
      allow read: if isOwner() || isSelf(userId);
      allow write: if false;
    }

    match /subscriptionPayments/{paymentId} {
      allow read: if isOwner()
        || (signedIn() && resource.data.get('userId', '') == request.auth.uid);
      allow write: if false;
    }

    match /paddleWebhookEvents/{eventId} {
      allow read, write: if false;
    }

    match /studentLoginRateLimits/{document=**} {
      allow read, write: if false;
    }

    // Deny new collections by default until their authorization model is explicit.
    match /{document=**} {
      allow read, write: if false;
    }
    // Add this inside your main match /databases/{database}/documents { ... } block

match /courseRegistrations/{registrationId} {
  // Public visitors can send a registration request.
  // They cannot read, update, or delete requests.
  allow create: if
    request.resource.data.keys().hasOnly([
      "studentName",
      "parentName",
      "grade",
      "phone",
      "courseId",
      "courseTitle",
      "preferredTime",
      "notes",
      "language",
      "status",
      "source",
      "createdAt"
    ])
    && request.resource.data.studentName is string
    && request.resource.data.studentName.size() >= 2
    && request.resource.data.studentName.size() <= 120
    && request.resource.data.parentName is string
    && request.resource.data.parentName.size() >= 2
    && request.resource.data.parentName.size() <= 120
    && request.resource.data.grade is string
    && request.resource.data.grade.size() >= 1
    && request.resource.data.grade.size() <= 60
    && request.resource.data.phone is string
    && request.resource.data.phone.size() >= 8
    && request.resource.data.phone.size() <= 20
    && request.resource.data.courseId in [
      "private-math",
      "little-programmer",
      "cs-lessons"
    ]
    && request.resource.data.courseTitle is string
    && request.resource.data.preferredTime is string
    && request.resource.data.preferredTime.size() >= 2
    && request.resource.data.preferredTime.size() <= 120
    && request.resource.data.notes is string
    && request.resource.data.notes.size() <= 1000
    && request.resource.data.language in ["ar", "en", "he"]
    && request.resource.data.status == "new"
    && request.resource.data.source == "public-courses-page"
    && request.resource.data.createdAt == request.time;

  allow read, update, delete: if false;
}

// Add this inside:
// match /databases/{database}/documents { ... }
//
// If you already added a courseRegistrations match,
// replace that entire block with this version.

match /courseRegistrations/{registrationId} {

  // Public visitors may submit a registration request.
  allow create: if
    request.resource.data.keys().hasOnly([
      "studentName",
      "parentName",
      "grade",
      "phone",
      "courseId",
      "courseTitle",
      "preferredTime",
      "notes",
      "language",
      "status",
      "source",
      "createdAt"
    ])
    && request.resource.data.studentName is string
    && request.resource.data.studentName.size() >= 2
    && request.resource.data.studentName.size() <= 120

    && request.resource.data.parentName is string
    && request.resource.data.parentName.size() >= 2
    && request.resource.data.parentName.size() <= 120

    && request.resource.data.grade is string
    && request.resource.data.grade.size() >= 1
    && request.resource.data.grade.size() <= 60

    && request.resource.data.phone is string
    && request.resource.data.phone.size() >= 8
    && request.resource.data.phone.size() <= 20

    && request.resource.data.courseId in [
      "private-math",
      "little-programmer",
      "cs-lessons"
    ]

    && request.resource.data.courseTitle is string

    && request.resource.data.preferredTime is string
    && request.resource.data.preferredTime.size() >= 2
    && request.resource.data.preferredTime.size() <= 120

    && request.resource.data.notes is string
    && request.resource.data.notes.size() <= 1000

    && request.resource.data.language in [
      "ar",
      "en",
      "he"
    ]

    && request.resource.data.status == "new"
    && request.resource.data.source == "public-courses-page"
    && request.resource.data.createdAt == request.time;


  // Only Owner can see registration requests.
  allow get, list: if isOwner();


  // Owner can only change status + update time.
  allow update: if
    isOwner()
    && request.resource.data.diff(resource.data)
      .affectedKeys()
      .hasOnly([
        "status",
        "updatedAt"
      ])
    && request.resource.data.status in [
      "new",
      "contacted",
      "confirmed",
      "closed"
    ]
    && request.resource.data.updatedAt == request.time;


  // Do not permanently delete requests from browser.
  allow delete: if false;
}

  }

}

